# Copy to terraform.tfvars and set your OpenStack IDs and image names.

name = "mke4-demo"

networks = {
  "internal-network" = {
    nodegroups = ["controller", "worker"]
    subnets = {
      "subnet_1" = {
        cidr    = "10.0.0.0/24"
        private = false
      }
    }
  }
}

nodegroups = {
  "controller" = {
    source_image = "<openstack-image-id>" # Rocky 9.4, RHEL 9.6/8.10, Ubuntu 24.04/22.04
    # keypair omitted: defaults to "${name}-kp" (generated by this example)
    flavor  = "<flavor-id>" # 8 GB RAM, 2 vCPUs min (16 GB / 4 vCPUs for upgrade path)
    count   = 3
    role    = "controller"
    public  = false
    user    = "cloud-user"  # cloud-user (RHEL/Rocky), ubuntu (Ubuntu)
  }
  "worker" = {
    source_image = "<openstack-image-id>"
    flavor       = "<flavor-id>" # 8 GB RAM, 2 vCPUs min
    count        = 2
    role         = "worker"
    public       = false
    user         = "cloud-user"
  }
}

external_network = {
  id       = "<external-network-id>"
  fip_pool = "external"
}

# Optional: disable SELinux and schedule reboot in 1 min so it fully applies (RHEL/Rocky/Fedora-like).
# disable_selinux = true

# Optional: extra cloud-config YAML for all nodes (no #cloud-config line).
# cloud_init_extra = <<-EXTRA
# packages:
#   - curl
# EXTRA


# Optional: when true, system-upgrade-controller manifests are deployed to
# /var/lib/k0s/manifests/system-upgrade/ on controller nodes after creation,
# and the MKE 4k config is extended with the ucpauthz exemptUsers entry for the
# system-upgrade service account.
# is_bootc_based = false